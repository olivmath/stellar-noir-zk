{"noir_version":"1.0.0-beta.15+83245db91dcf63420ef4bcbbd85b98f397fee663","hash":"9241962781527732239","abi":{"parameters":[{"name":"birth","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"private"},{"name":"today","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"private"}],"return_type":{"abi_type":{"kind":"boolean"},"visibility":"public"},"error_types":{"1998584279744703196":{"error_kind":"string","string":"attempt to subtract with overflow"}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"fn split_yyyymmdd(yyyymmdd: u32) -> (u32, u32, u32) {\n    let year = yyyymmdd / 10000;\n    let md = yyyymmdd % 10000;\n    let month = md / 100;\n    let day = md % 100;\n    (year, month, day)\n}\n\nfn is_adult(birth: u32, today: u32) -> bool {\n    let (by, bm, bd) = split_yyyymmdd(birth);\n    let (ty, tm, td) = split_yyyymmdd(today);\n    let dy = ty - by;\n    let gt18 = dy > 18;\n    let eq18 = dy == 18;\n    let month_ok = if tm > bm { true } else { if tm == bm { td >= bd } else { false } };\n    if gt18 { true } else { if eq18 { month_ok } else { false } }\n}\n\nfn main(birth: u32, today: u32) -> pub bool {\n    is_adult(birth, today)\n}","path":"/Users/olivmath/dev/stellar-noir/circuit/src/main.nr"}},"expression_width":{"Bounded":{"width":4}}}